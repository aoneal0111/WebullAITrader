WEBULL_MCP_URL=http://127.0.0.1:8000/mcp
LOG_LEVEL=INFO
MCP_TIMEOUT_SECONDS=30

# Operational deployment (LIVE requires every value and explicit enablement)
WEBULL_TRADING_ENVIRONMENT=TEST
LIVE_TRADING_ENABLED=false
WEBULL_ACCOUNT_ID=
WEBULL_API_KEY=
WEBULL_API_SECRET=
WEBULL_API_BASE_URL=https://api.sandbox.webull.com
WEBULL_STREAM_URL=wss://data-api.sandbox.webull.com:8883/mqtt

# Optional independent clients. A scoped section must be supplied completely;
# otherwise the legacy WEBULL_* values above remain in effect.
WEBULL_TRADING_ACCOUNT_ID=
WEBULL_TRADING_APP_KEY=
WEBULL_TRADING_APP_SECRET=
WEBULL_TRADING_API_BASE_URL=
WEBULL_TRADING_STREAM_URL=
WEBULL_MARKET_DATA_ENVIRONMENT=PRODUCTION
WEBULL_MARKET_DATA_APP_KEY=
WEBULL_MARKET_DATA_APP_SECRET=
WEBULL_MARKET_DATA_API_BASE_URL=https://api.webull.com
WEBULL_MARKET_DATA_STREAM_URL=wss://data-api.webull.com:8883/mqtt
AUTHORIZATION_DATABASE_PATH=data/authorization.sqlite3
EXECUTION_DATABASE_PATH=data/execution.sqlite3
MARKET_EVENT_DATABASE_PATH=data/market-events.sqlite3
EMERGENCY_STOP_DATABASE_PATH=data/emergency-stop.sqlite3
LOG_LEVEL=INFO
HEALTH_PORT=8080
MAX_ORDER_NOTIONAL=10
MAX_DAILY_NOTIONAL=50
MAX_OPEN_POSITIONS=1
MAX_OPEN_ORDERS=1
MAX_ORDER_RATE=5
MAX_QUANTITY_PER_SYMBOL=1
ALLOWED_SYMBOLS=
MARKET_DATA_STREAMING_ENABLED=true
# Optional legacy seed symbols. The autonomous scanner discovers its normal
# subscription universe through the official Webull screener.
MARKET_DATA_SYMBOLS=
BLOCKED_SYMBOLS=
MAXIMUM_MARKET_DATA_AGE_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=30
MAXIMUM_RECONCILIATION_AGE_SECONDS=60
MAXIMUM_UNRESOLVED_MUTATIONS=0

# Large research and trading datasets
WEBULL_DATA_ROOT=D:\WebullData
# Strategy selection remains production-compatible by default. The Warrior
# experiment is observational/replay/paper-only and cannot authorize live orders.
ATLAS_STRATEGY=existing
WARRIOR_MOMENTUM_V1_LIVE_EXECUTION_ENABLED=false
WARRIOR_FORWARD_PAPER_ENABLED=false
WARRIOR_FORWARD_CAPTURE_PATH=data/warrior_momentum_v1_forward/forward_capture.sqlite3
