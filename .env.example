WEBULL_MCP_URL=http://127.0.0.1:8000/mcp
LOG_LEVEL=INFO
MCP_TIMEOUT_SECONDS=30

# Operational deployment (LIVE requires every value and explicit enablement)
TRADING_ENVIRONMENT=TEST
LIVE_TRADING_ENABLED=false
WEBULL_ACCOUNT_ID=
WEBULL_API_KEY=
WEBULL_API_SECRET=
WEBULL_API_BASE_URL=https://api.sandbox.webull.com
WEBULL_STREAM_URL=wss://data-api.sandbox.webull.com:8883/mqtt
AUTHORIZATION_DATABASE_PATH=data/authorization.sqlite3
EXECUTION_DATABASE_PATH=data/execution.sqlite3
MARKET_EVENT_DATABASE_PATH=data/market-events.sqlite3
EMERGENCY_STOP_DATABASE_PATH=data/emergency-stop.sqlite3
LOG_LEVEL=INFO
HEALTH_PORT=8080
MAX_ORDER_NOTIONAL=10
MAX_DAILY_NOTIONAL=50
MAX_OPEN_POSITIONS=1
MAX_OPEN_ORDERS=1
MAX_ORDER_RATE=5
MAX_QUANTITY_PER_SYMBOL=1
ALLOWED_SYMBOLS=
BLOCKED_SYMBOLS=
MAXIMUM_MARKET_DATA_AGE_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=30
MAXIMUM_RECONCILIATION_AGE_SECONDS=60
MAXIMUM_UNRESOLVED_MUTATIONS=0

# Large research and trading datasets
WEBULL_DATA_ROOT=D:\WebullData
